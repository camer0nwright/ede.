# Copy this file to .env and fill in the values. Never commit .env.
DATABASE_URL="file:./dev.db"
# Hosted (Vercel): DATABASE_URL is the Turso URL (libsql://...) and this is its token.
# Set both in Vercel's settings and in .env.turso (for npm run db:deploy), never here.
# DATABASE_AUTH_TOKEN=

# The AI coach (tailoring weeks). Add your own key to .env, never here: https://console.anthropic.com
# ANTHROPIC_API_KEY=

# Local test account for trying sign-in on the dev server (test data only, never a real password).
TEST_ACCOUNT_EMAIL="connie.test@ede.localhost"
TEST_ACCOUNT_PASSWORD="ioyPLFhIRug3vPX"

# Shown on the privacy page as the contact for privacy questions. Set before launch.
# PRIVACY_CONTACT_EMAIL=

# Password reset emails (Resend). Without a key, development prints each email in the terminal.
# Add your key to .env and to Vercel, never here: https://resend.com
# RESEND_API_KEY=
# EMAIL_FROM="ede. <hello@trainwithede.com>"
# The site's address for links in emails. On Vercel it falls back to the production domain.
# APP_URL=https://trainwithede.com

# Error reports (Sentry). Off unless the DSN is set. The DSN isn't secret (it ends up in the browser);
# SENTRY_AUTH_TOKEN is, so it goes in Vercel only, never here.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
